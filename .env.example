# Variables SOLO de servidor. Configurar en Vercel; nunca subir valores reales a GitHub.
DATABASE_URL=postgresql://<usuario>:<clave>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Autorización OAuth de una cuenta de Google con permiso de Editor sobre la carpeta.
# La cuenta autoriza una vez; el visitante del dashboard NO inicia sesión en Google.
GOOGLE_OAUTH_CLIENT_ID=<oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<oauth-client-secret>
GOOGLE_OAUTH_REFRESH_TOKEN=<oauth-refresh-token>
GOOGLE_DRIVE_FOLDER_ID=1yhEGQA2a3V4liYlqQYiGbvCrqFML5CAq

